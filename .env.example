# The widget needs NO environment variables or API keys to run.
# Credentials (ClickUp, Google, Slack) are entered in Ajustes > Cuentas and stored encrypted.
#
# The variables below exist only for automated tests and local development.
# Never put real tokens in this file.

# Show demo data instead of real accounts
# WIDGET_FAKE_DATA=1

# Point the ClickUp client at a local mock server
# CLICKUP_API_BASE=http://127.0.0.1:8799/api/v2

# Point the Slack clients at a local mock server (keep the trailing slash)
# SLACK_API_URL=http://127.0.0.1:8798/api/
