{
  "display_information": {
    "name": "Widget CESA",
    "description": "Lee tus mensajes directos y menciones para mostrarlos en el widget de escritorio. Solo lectura."
  },
  "oauth_config": {
    "scopes": {
      "user": [
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "channels:read",
        "groups:read",
        "im:read",
        "mpim:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "user_events": ["message.channels", "message.groups", "message.im", "message.mpim"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
